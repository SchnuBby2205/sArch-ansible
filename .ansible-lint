skip_list:
  - var-naming[no-role-prefix]   # sarch_* ist bewusst einheitlich
  - name[casing]                 # deutsche Tasknamen
  - latest[git]                  # Wallpaper-Repo bewusst nicht pinnen
  - yaml[commas]                 # Spalten-Ausrichtung in group_vars
exclude_paths:
  - configs/
  - bin/
  - themes/
  - fonts/
